    },
    "auth": {
        "type": "noauth"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://127.0.0.1:8000",
            "type": "string"
        },
        {
            "key": "csrfToken",
            "value": "",
            "type": "string"
        },
        {
            "key": "userBookId",
            "value": "1",
            "type": "string"
        },
        {
            "key": "bookId",
            "value": "1",
            "type": "string"
        },
        {
            "key": "inventoryItemId",
            "value": "2",
            "type": "string"
        },
        {
            "key": "username",
            "value": "admin",
            "type": "string"
        },
        {
            "key": "password",
            "value": "admin123",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Autenticación",
            "item": [
                {
                    "name": "Obtener cookie CSRF",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/sanctum/csrf-cookie",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "sanctum",
                                "csrf-cookie"
                            ]
                        },
                        "description": "Obtiene las cookies necesarias para la autenticación mediante sesiones de Laravel Sanctum."
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const xsrfCookie = pm.cookies.get('XSRF-TOKEN');",
                                    "if (xsrfCookie) {",
                                    "    pm.collectionVariables.set('csrfToken', decodeURIComponent(xsrfCookie));",
                                    "}"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Iniciar sesión",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "X-XSRF-TOKEN",
                                "value": "{{csrfToken}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"{{username}}\",\n    \"password\": \"{{password}}\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "login"
                            ]
                        },
                        "description": "Inicia sesión mediante Laravel Sanctum. Requiere obtener previamente la cookie CSRF."
                    },
                    "response": []
                },
                {
                    "name": "Cerrar sesión",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "X-XSRF-TOKEN",
                                "value": "{{csrfToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/logout",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "logout"
                            ]
                        },
                        "description": "Cierra la sesión del usuario autenticado e invalida su sesión actual."
                    },
                    "response": []
                }
            ]
        },
